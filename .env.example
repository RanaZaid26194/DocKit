# Example environment for DocKit.
# Copy to .env.local and fill in real values. See SECRETS.md for how to obtain each one.

# Your own Supabase project (Lovable Cloud is not used).
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# hCaptcha (free tier — bot protection on housing office signup)
VITE_HCAPTCHA_SITE_KEY=""
HCAPTCHA_SECRET=""

# MailerSend (transactional email — housing office invitations, decision receipts).
# Configured through Supabase Auth SMTP; only needed if you also send via server routes.
MAILERSEND_API_TOKEN=""
MAIL_FROM_ADDRESS="no-reply@yourdomain.org"
MAIL_FROM_NAME="DocKit"
